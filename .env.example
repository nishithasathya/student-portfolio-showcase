# Copy this file to .env for local overrides. Never commit the real .env
# file — it is already excluded by .gitignore.

# Flask session-signing key. The app falls back to an insecure development
# key if this is unset, which is fine locally but must be overridden in any
# shared or public deployment (SPS-SEC-005).
SECRET_KEY=change-me-to-a-long-random-value

# Leave unset locally to use the default SQLite file in instance/.
# In production (Render) this is set automatically from the linked
# PostgreSQL database — see docs/DEPLOYMENT.md.
DATABASE_URL=
